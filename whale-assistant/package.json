{
  "name": "@lengmu-cloud/dsh-whale-assistant",
  "version": "0.4.3-rc.1",
  "type": "module",
  "description": "dsh-whale-assistant: the companion whale for DeepSeek Harness - screen-level desktop pet, server-side history storage shared by every window, task notifications with usage reports, and hosting for the whale script itself",
  "files": [
    "lib/",
    "pet/",
    "client.js",
    "cordis.patch.yml",
    "locale/",
    "docs/",
    "whale-logo.svg",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "sessions",
        "conversation",
        "uiWorkspace"
      ],
      "platform": "web"
    }
  },
  "main": "lib/index.js",
  "author": "LengMu-Cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LengMu-Cloud/dsh-whale-assistant.git"
  }
}
